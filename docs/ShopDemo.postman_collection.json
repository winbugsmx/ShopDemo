{
  "info": {
    "_postman_id": "shopdemo-collection-2026",
    "name": "ShopDemo — APIs (Catalog, Orders, Inventory)",
    "description": "Colección de endpoints implementados en ShopDemo.\n\nPuertos por defecto:\n- Catalog: http://localhost:8001\n- Orders: http://localhost:8002\n- Inventory: http://localhost:8003\n\nVariables de colección: productId, orderId, customerId (se pueden actualizar tras ejecutar las peticiones de creación).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "catalogBaseUrl", "value": "http://localhost:8001" },
    { "key": "ordersBaseUrl", "value": "http://localhost:8002" },
    { "key": "inventoryBaseUrl", "value": "http://localhost:8003" },
    { "key": "customerId", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "productId", "value": "00000000-0000-0000-0000-000000000001" },
    { "key": "orderId", "value": "00000000-0000-0000-0000-000000000002" }
  ],
  "item": [
    {
      "name": "Catalog API",
      "description": "Microservicio de catálogo de productos (puerto 8001).",
      "item": [
        {
          "name": "Crear producto",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teclado Mecánico\",\n  \"description\": \"RGB, switches azules\",\n  \"price\": 89.99,\n  \"currency\": \"USD\",\n  \"stock\": 50,\n  \"category\": \"Electronics\"\n}"
            },
            "url": {
              "raw": "{{catalogBaseUrl}}/api/products",
              "host": ["{{catalogBaseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Registra un nuevo producto en el catálogo. Retorna el ProductId que se usará en Inventory y Orders.\n\nCategorías válidas: Electronics, Clothing, Food, Books, Sports."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Inventory API",
      "description": "Microservicio de inventario y stock (puerto 8003).",
      "item": [
        {
          "name": "Stock",
          "item": [
            {
              "name": "Registrar stock",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"productName\": \"Teclado Mecánico\",\n  \"units\": 50\n}"
                },
                "url": {
                  "raw": "{{inventoryBaseUrl}}/api/inventory/stock",
                  "host": ["{{inventoryBaseUrl}}"],
                  "path": ["api", "inventory", "stock"]
                },
                "description": "Registra stock inicial para un ProductId de Catalog. Si el producto ya existe en inventario, suma las unidades (reabastecimiento)."
              },
              "response": []
            },
            {
              "name": "Consultar stock por producto",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{inventoryBaseUrl}}/api/inventory/{{productId}}",
                  "host": ["{{inventoryBaseUrl}}"],
                  "path": ["api", "inventory", "{{productId}}"]
                },
                "description": "Consulta las unidades disponibles de un producto en inventario."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Reservas",
          "description": "Endpoints invocados normalmente por Orders API al confirmar o cancelar pedidos. Incluidos para pruebas directas.",
          "item": [
            {
              "name": "Reservar stock (pedido)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"lines\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
                },
                "url": {
                  "raw": "{{inventoryBaseUrl}}/api/inventory/reservations",
                  "host": ["{{inventoryBaseUrl}}"],
                  "path": ["api", "inventory", "reservations"]
                },
                "description": "Descuenta unidades del stock disponible para las líneas de un pedido. Orders lo invoca automáticamente al confirmar."
              },
              "response": []
            },
            {
              "name": "Liberar stock (cancelación)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"lines\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
                },
                "url": {
                  "raw": "{{inventoryBaseUrl}}/api/inventory/reservations/release",
                  "host": ["{{inventoryBaseUrl}}"],
                  "path": ["api", "inventory", "reservations", "release"]
                },
                "description": "Devuelve unidades al inventario cuando un pedido confirmado se cancela. Orders lo invoca automáticamente."
              },
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "Orders API",
      "description": "Microservicio de pedidos (puerto 8002).",
      "item": [
        {
          "name": "Crear pedido",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"shippingAddress\": {\n    \"street\": \"Av. Reforma 123\",\n    \"city\": \"Ciudad de México\",\n    \"postalCode\": \"06600\",\n    \"country\": \"MX\"\n  },\n  \"lines\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"productName\": \"Teclado Mecánico\",\n      \"unitPrice\": 89.99,\n      \"currency\": \"USD\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{ordersBaseUrl}}/api/orders",
              "host": ["{{ordersBaseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Crea un pedido en estado Pending. Las líneas referencian ProductId de Catalog (snapshot de nombre y precio)."
          },
          "response": []
        },
        {
          "name": "Consultar pedido por Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ordersBaseUrl}}/api/orders/{{orderId}}",
              "host": ["{{ordersBaseUrl}}"],
              "path": ["api", "orders", "{{orderId}}"]
            },
            "description": "Obtiene el detalle de un pedido por su identificador."
          },
          "response": []
        },
        {
          "name": "Listar pedidos por cliente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ordersBaseUrl}}/api/orders?customerId={{customerId}}",
              "host": ["{{ordersBaseUrl}}"],
              "path": ["api", "orders"],
              "query": [
                { "key": "customerId", "value": "{{customerId}}" }
              ]
            },
            "description": "Lista todos los pedidos de un cliente."
          },
          "response": []
        },
        {
          "name": "Confirmar pedido",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{ordersBaseUrl}}/api/orders/{{orderId}}/confirm",
              "host": ["{{ordersBaseUrl}}"],
              "path": ["api", "orders", "{{orderId}}", "confirm"]
            },
            "description": "Confirma el pedido (Pending → Confirmed). Reserva stock automáticamente en Inventory API."
          },
          "response": []
        },
        {
          "name": "Cancelar pedido",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"El cliente solicitó la cancelación\"\n}"
            },
            "url": {
              "raw": "{{ordersBaseUrl}}/api/orders/{{orderId}}/cancel",
              "host": ["{{ordersBaseUrl}}"],
              "path": ["api", "orders", "{{orderId}}", "cancel"]
            },
            "description": "Cancela el pedido con motivo. Si estaba confirmado, libera el stock reservado en Inventory."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Flujo integrado (E2E)",
      "description": "Secuencia recomendada para probar el proceso completo de compra. Ejecutar en orden y actualizar las variables productId y orderId con los valores devueltos.",
      "item": [
        {
          "name": "1. Crear producto (Catalog)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teclado Mecánico\",\n  \"description\": \"RGB, switches azules\",\n  \"price\": 89.99,\n  \"currency\": \"USD\",\n  \"stock\": 50,\n  \"category\": \"Electronics\"\n}"
            },
            "url": {
              "raw": "{{catalogBaseUrl}}/api/products",
              "host": ["{{catalogBaseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Paso 1: Crear producto. Copiar el 'id' de la respuesta a la variable productId."
          },
          "response": []
        },
        {
          "name": "2. Registrar stock (Inventory)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"productName\": \"Teclado Mecánico\",\n  \"units\": 50\n}"
            },
            "url": {
              "raw": "{{inventoryBaseUrl}}/api/inventory/stock",
              "host": ["{{inventoryBaseUrl}}"],
              "path": ["api", "inventory", "stock"]
            },
            "description": "Paso 2: Registrar stock para el ProductId obtenido en el paso 1."
          },
          "response": []
        },
        {
          "name": "3. Crear pedido (Orders)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"shippingAddress\": {\n    \"street\": \"Av. Reforma 123\",\n    \"city\": \"Ciudad de México\",\n    \"postalCode\": \"06600\",\n    \"country\": \"MX\"\n  },\n  \"lines\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"productName\": \"Teclado Mecánico\",\n      \"unitPrice\": 89.99,\n      \"currency\": \"USD\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{ordersBaseUrl}}/api/orders",
              "host": ["{{ordersBaseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Paso 3: Crear pedido. Copiar el 'id' de la respuesta a la variable orderId."
          },
          "response": []
        },
        {
          "name": "4. Confirmar pedido (Orders → reserva stock)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{ordersBaseUrl}}/api/orders/{{orderId}}/confirm",
              "host": ["{{ordersBaseUrl}}"],
              "path": ["api", "orders", "{{orderId}}", "confirm"]
            },
            "description": "Paso 4: Confirmar pedido. Orders reserva stock en Inventory automáticamente."
          },
          "response": []
        },
        {
          "name": "5. Consultar stock (Inventory)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventoryBaseUrl}}/api/inventory/{{productId}}",
              "host": ["{{inventoryBaseUrl}}"],
              "path": ["api", "inventory", "{{productId}}"]
            },
            "description": "Paso 5: Verificar stock. Esperado: 48 unidades (50 - 2 reservadas)."
          },
          "response": []
        },
        {
          "name": "6. Cancelar pedido (Orders → libera stock)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Cliente solicitó cancelación\"\n}"
            },
            "url": {
              "raw": "{{ordersBaseUrl}}/api/orders/{{orderId}}/cancel",
              "host": ["{{ordersBaseUrl}}"],
              "path": ["api", "orders", "{{orderId}}", "cancel"]
            },
            "description": "Paso 6 (opcional): Cancelar pedido confirmado. Libera las 2 unidades reservadas."
          },
          "response": []
        },
        {
          "name": "7. Verificar stock restaurado (Inventory)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventoryBaseUrl}}/api/inventory/{{productId}}",
              "host": ["{{inventoryBaseUrl}}"],
              "path": ["api", "inventory", "{{productId}}"]
            },
            "description": "Paso 7: Tras cancelar, el stock debe volver a 50 unidades."
          },
          "response": []
        }
      ]
    }
  ]
}
