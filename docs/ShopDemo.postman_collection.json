          },
          "response": []
        },
        {
          "name": "Inventory — Alive",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{inventoryBaseUrl}}/alive", "host": ["{{inventoryBaseUrl}}"], "path": ["alive"] }
          },
          "response": []
        },
        {
          "name": "Analytics — Health (ServiceDefaults)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{analyticsBaseUrl}}/health", "host": ["{{analyticsBaseUrl}}"], "path": ["health"] }
          },
          "response": []
