# =============================================================================
# ShopDemo — Configuración AWS (plantilla)
# =============================================================================
# 1. Copia:  copy .env.aws.example .env.aws
# 2. Completa los valores marcados con <<< >>>
# 3. NO subas .env.aws al repositorio
#
# Documentación:
#   - docs/despliegue/aws/PREPARACION-AMBIENTE-AWS.md
#   - docs/despliegue/aws/GUIA-RELEASE-SCRIPT-AWS.md
#   - docs/despliegue/aws/GUIA-RELEASE-CLI-AWS.md
#   - docs/despliegue/eks/IMPLEMENTACION-DESPLIEGUE-EKS.md
#   - docs/INTEGRACION-AZURE-EVENT-HUBS.md (Event Hubs sigue en Azure)
#   - docs/integracion-ia/IMPLEMENTACION-DESPLIEGUE-MCP-AWS.md
# =============================================================================

# --- Cuenta y región (Consola: barra superior / IAM → Security credentials) ---
AWS_REGION=us-east-2
# Perfil opcional de ~/.aws/credentials (dejar vacío para default)
AWS_PROFILE=

# --- Event Hubs (Azure Portal — cross-cloud; NO se crea en AWS) ---
# Namespace → Shared access policies → RootManageSharedAccessKey → Primary Connection String
# Ref: docs/INTEGRACION-AZURE-EVENT-HUBS.md §4.4
EVENT_HUBS_CONNECTION_STRING=<<<PEGAR-CONNECTION-STRING-AZURE-EVENT-HUBS>>>
EVENT_HUB_NAME=shopdemo-events

# --- Red y cluster ECS (modos ECS y All) ---
LAB_PREFIX=shopdemo
VPC_CIDR=10.0.0.0/16
ECS_CLUSTER_NAME=shopdemo-cluster

# --- PostgreSQL en ECS Fargate (modos ECS y All) ---
POSTGRES_USER=ShopDemo
POSTGRES_PASSWORD=ShopDemo123!

# --- Imágenes ECR (el script NO hace build) ---
IMAGE_TAG=latest

# --- EKS (modos EKS y All) ---
# Free Tier lab: t3.micro (t3.medium falla con "not eligible for Free Tier")
# 4 nodos = 16 pods max (4 pods/nodo); ver perfil eks-free-tier-lab en GUIA-RELEASE-SCRIPT-AWS.md
EKS_CLUSTER_NAME=shopdemo-eks
EKS_NODE_TYPE=t3.micro
EKS_NODE_COUNT=4

# --- Cloud Map DNS privado para Inventory (ECS) ---
CLOUDMAP_NAMESPACE=shopdemo.local

# --- Referencia GitHub (build vía .github/workflows/deploy-aws.yml) ---
GITHUB_REPO_URL=https://github.com/TU-ORG/ShopDemo
