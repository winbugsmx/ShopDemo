# =============================================================================
# ShopDemo — Configuración Azure (plantilla)
# =============================================================================
# 1. Copia este archivo:  copy .env.azure.example .env.azure
# 2. Completa los valores marcados con <<< >>>
# 3. NO subas .env.azure al repositorio (contiene secretos)
#
# Documentación:
#   - docs/despliegue/azure/IMPLEMENTACION-DESPLIEGUE-AZURE.md
#   - docs/despliegue/aks/IMPLEMENTACION-DESPLIEGUE-AKS.md
#   - docs/INTEGRACION-AZURE-EVENT-HUBS.md
#   - docs/integracion-ia/IMPLEMENTACION-DESPLIEGUE-MCP-AZURE.md
# =============================================================================

# --- Suscripción y región (Portal: Subscriptions → Overview) ---
AZURE_SUBSCRIPTION_ID=<<<TU-SUBSCRIPTION-ID-GUID>>>
AZURE_LOCATION=eastus

# --- Resource Group (un solo grupo para todo el lab) ---
RESOURCE_GROUP=rg-shopdemo-lab

# --- Azure Container Registry (nombre GLOBAL único: solo a-z y 0-9) ---
ACR_NAME=acrshopdemolab01

# --- Event Hubs (Portal: Event Hubs namespace → nombre único global) ---
# Ref: docs/INTEGRACION-AZURE-EVENT-HUBS.md §4
EVENT_HUB_NAMESPACE=shopdemo-eh-ns-lab01
EVENT_HUB_NAME=shopdemo-events

# --- Storage Account para checkpoints en ACA (Inventory + Analytics) ---
# Portal: Storage accounts → nombre único global
# En AKS se usa Azurite dentro del cluster (k8s/azurite/); no este storage.
STORAGE_ACCOUNT_NAME=shopdemochecklab01

# --- PostgreSQL en ACI (solo modos ACA y All) ---
# Portal: no aplica; la contraseña la defines tú para el contenedor postgres:16-alpine
POSTGRES_USER=ShopDemo
POSTGRES_PASSWORD=ShopDemo123!
POSTGRES_ACI_NAME=aci-shopdemo-postgres
POSTGRES_DNS_LABEL=shopdemo-pg-lab

# --- Container Apps (modos ACA y All) ---
LOG_ANALYTICS_NAME=log-shopdemo
ACA_ENV_NAME=aca-env-shopdemo
IMAGE_TAG=latest

# --- AKS (modos AKS y All) ---
# Portal: Kubernetes services → nombre del cluster
AKS_CLUSTER_NAME=aks-shopdemo
AKS_NODE_COUNT=1
AKS_NODE_VM_SIZE=Standard_B2s

# --- Referencia opcional (el script NO hace build desde GitHub) ---
# Publica imágenes con .github/workflows/deploy-azure.yml o build manual (doc §6)
GITHUB_REPO_URL=https://github.com/TU-ORG/ShopDemo
